#!/bin/sh
# install-tools: the command line every house shares (Art's and Mark's), from the
# loom-box checkout a house image already fetches at its runtime pin. One copy,
# so the houses stop drifting apart (2026-11-06: Mark's house had no `approvals`,
# an older piece-call, and lost its whole PATH in Codex's shells).
#
#   install-tools            the wrappers below, and the login-shell PATH (root only)
#   install-tools --pieces   the piece wrappers only (a house that links its own
#                            over them at start puts these back afterwards)
#
# Into $HOME/.local/bin:
#   piece-call     this checkout's house/piece-call (loom's piece API, the house's own token)
#   loom-runtime   node, by its full path, on this checkout's src/cli.mjs
#   taskstore, loom-tasks   loom's tasks piece through piece-call; the house's own
#                  taskstore build instead when TASKSTORE_DB names a store (a test's
#                  store: through the piece it would write the one store, t-1520)
#                  or TANK_LOCAL_PIECES is set
#   wake           loom's clock piece
#   approvals      loom's approvals piece
#
# And /etc/profile.d/loom-house.sh: Debian's /etc/profile resets PATH to the
# system dirs, and Codex runs every command in a login shell (`bash -lc`), so
# without it a Codex body finds no loom, no node and no wrappers at all. It puts
# back the PATH this ran under (run it after the Containerfile's last ENV PATH)
# and reads ~/.house-env, which the entrypoint writes for shells started later
# (LOOM_TOKEN_FILE and the like).
#
# Run it as the house's own user, with node on PATH. LOOM_HOUSE_PROFILE_D moves
# the profile file (the tests).
set -eu

case "${1:-}" in
  "") pieces_only= ;;
  --pieces) pieces_only=1 ;;
  *) echo "usage: install-tools [--pieces]" >&2; exit 2 ;;
esac

KIT=$(cd "$(dirname "$0")/.." && pwd -P)
BIN="${HOME:?}/.local/bin"
NODE=$(node -e 'process.stdout.write(process.execPath)')
TASKSTORE_CLI="$HOME/.local/share/taskstore/dist/cli.js"
mkdir -p "$BIN"

put() {  # put NAME: stdin becomes $BIN/NAME, executable (replaces a link or file)
  cat > "$BIN/.$1.new"
  chmod 0755 "$BIN/.$1.new"
  mv -f "$BIN/.$1.new" "$BIN/$1"
}

piece() {  # piece NAME PIECE
  put "$1" <<EOF
#!/bin/sh
# $1: loom's $2 piece, through loom's piece API (loom-box house/install-tools).
exec "$BIN/piece-call" $2 "\$@"
EOF
}

ln -sfn "$KIT/house/piece-call" "$BIN/piece-call"

for name in taskstore loom-tasks; do
  put "$name" <<EOF
#!/bin/sh
# $name: loom's tasks piece, through loom's piece API (loom-box house/install-tools).
# A call that names its own store (TASKSTORE_DB), or a house kept on its local
# pieces (TANK_LOCAL_PIECES), runs the house's own taskstore build on it.
if [ -n "\${TASKSTORE_DB:-}\${TANK_LOCAL_PIECES:-}" ] && [ -f "$TASKSTORE_CLI" ]; then
  exec "$NODE" "$TASKSTORE_CLI" "\$@"
fi
exec "$BIN/piece-call" tasks "\$@"
EOF
done
piece wake clock
piece approvals approvals

[ -n "$pieces_only" ] && exit 0

put loom-runtime <<EOF
#!/bin/sh
# loom-runtime: the runtime piece's CLI at this house's pin (loom-box house/install-tools).
exec "$NODE" "$KIT/src/cli.mjs" "\$@"
EOF

PROFILE_D="${LOOM_HOUSE_PROFILE_D:-/etc/profile.d}"
if [ -d "$PROFILE_D" ] && [ -w "$PROFILE_D" ]; then
  q=$(printf '%s' "$PATH" | sed "s/'/'\\\\''/g")
  cat > "$PROFILE_D/loom-house.sh" <<EOF
# loom-house.sh (loom-box house/install-tools): a login shell keeps the house's
# command line. /etc/profile has just reset PATH to the system dirs; Codex runs
# every command in a login shell. This is the image's PATH, as built.
PATH='$q'
export PATH
[ -r "\$HOME/.house-env" ] && . "\$HOME/.house-env"
true
EOF
  chmod 0644 "$PROFILE_D/loom-house.sh"
else
  echo "install-tools: $PROFILE_D isn't writable here; login shells keep /etc/profile's PATH" >&2
fi
