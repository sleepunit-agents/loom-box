#!/usr/bin/env python3
"""piece-call — run a loom piece's CLI from a body that isn't on loom's machine.

    piece-call tasks ready
    piece-call clock in 4h -f routines/plan.md --note "t-1 round 2"

POSTs {argv} to loom's piece API (`/api/<piece>/run`, loom docs/extensions.md
"The API") as this body's own token, then prints the command's stdout and
stderr and exits with its exit code, so it reads exactly like the local
command. In a house, house/install-tools puts `taskstore`, `wake` and
`approvals` in front of this (as tasks, clock and approvals). Needs LOOM_URL
(the /mcp URL is fine) and LOOM_TOKEN_FILE, or in a house (HOUSE_ID set) its
/run/secrets/loom-token. With no arguments it asks the piece itself (`wake`
alone, like the local command).

The one copy every house runs (loom-box house/). sleepunit-agents/art keeps
bin/piece-call, the same program, for loom's own machine.

For approvals and clock, a body in a conversation (LOOM_BODY_CONVERSATION) also
sends `--principal <statement>` (any it typed is taken off first): on whose behalf it acts, signed by the runtime
(`loom-runtime principal`, t-1943; PIECE_CALL_RUNTIME names another program,
for tests). Without one the piece treats the body as acting for someone it
can't name, never the owner.

Exit 1 with loom's words when the call itself fails (refused, unreachable).
"""
import base64
import gzip
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request


def inline_file(piece, argv):
    """`tasks comment <id> --file <path|->`: the text is read here and sent as the comment's own argument.
    Only argv crosses to loom, so loom's CLI would read an empty stdin or a path it can't see (t-1854's
    safe form failed in every house with "--file - has no text", 2026-11-04 reflect)."""
    if piece != "tasks" or not argv or argv[0] != "comment" or "--file" not in argv:
        return argv
    i = argv.index("--file")
    if i + 1 >= len(argv):
        return argv
    src = argv[i + 1]
    if src == "-":
        text = sys.stdin.read()
    else:
        with open(src) as f:
            text = f.read()
    return argv[:i] + argv[i + 2:] + [text.rstrip("\n")]


# The pieces that decide by on whose behalf a body acts (t-1943): approvals (whose standing rules and grants apply)
# and the clock (whose a wake is). They get a signed statement of this body's principal, from the runtime.
PRINCIPAL_PIECES = {"approvals", "clock"}


def in_body():
    """Whether this runs in a body holding a conversation: its run's key, or a conversation its environment names."""
    return bool(os.environ.get("LOOM_BODY_KEY")) or bool(
        re.fullmatch(r"cv-[0-9a-f]{12}", os.environ.get("LOOM_BODY_CONVERSATION", "")))


def principal_statement():
    """This body's principal, as the runtime signs it (`loom-runtime principal`: its conversation, proven with its run's
    key and session), and the conversation it names: (statement, conversation), or (None, None). The runtime's CLI
    tells the body's own conversation (its house says which one its session holds, t-2053): never this process's
    LOOM_BODY_CONVERSATION alone, which a reused `claude --bg` session keeps from the body it was first started for.
    The run's key stays with the runtime; the piece checks the statement on loom's machine. Anything that fails gives
    (None, None), and the piece then treats the body as acting for someone it can't name (never the owner)."""
    if not in_body():
        return None, None
    exe = os.environ.get("PIECE_CALL_RUNTIME") or shutil.which("loom-runtime")
    if not exe:
        return None, None
    try:
        r = subprocess.run([exe, "principal"], capture_output=True, text=True, timeout=45, stdin=subprocess.DEVNULL)
        out = json.loads(r.stdout or "{}")
    except (OSError, ValueError, subprocess.SubprocessError):
        return None, None
    if not isinstance(out, dict) or out.get("ok") is not True:
        return None, None
    st = out.get("statement")
    st = st if isinstance(st, str) and 0 < len(st) <= 8000 and not re.search(r"\s", st) else None
    cv = out.get("conversation")
    cv = cv if isinstance(cv, str) and re.fullmatch(r"cv-[0-9a-f]{12}", cv) else None
    if not cv:
        # An answer that names none (an older runtime): its environment's, which it answered for.
        env_cv = os.environ.get("LOOM_BODY_CONVERSATION", "")
        cv = env_cv if re.fullmatch(r"cv-[0-9a-f]{12}", env_cv) else None
    return st, cv


def with_principal(piece, argv):
    """argv with the runtime's `--principal <statement>` appended, for a piece that decides by it. Any the caller typed
    (`--principal X`, `--principal=X`) is taken off first: the piece sees the runtime's, or none (someone it can't name)."""
    if piece not in PRINCIPAL_PIECES:
        return argv
    clean, i = [], 0
    while i < len(argv):
        if argv[i] == "--principal":
            i += 2
            continue
        if argv[i].startswith("--principal="):
            i += 1
            continue
        clean.append(argv[i])
        i += 1
    st, cv = principal_statement()
    # The house executes this bridge, not the approvals piece's standalone main.
    # Keep its conversation link here too; it is display provenance, never trust: the one the runtime answered for,
    # and none when it couldn't tell (never an environment's that may be another conversation's, t-2053).
    if piece == "approvals" and clean[:1] == ["request"] and cv and not any(
            a == "--conversation" or a.startswith("--conversation=") for a in clean):
        clean += ["--conversation", cv]
    return clean + ["--principal", st] if st else clean


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__.strip().splitlines()[0] + "\nusage: piece-call <piece> <args...>")
    piece, argv = sys.argv[1], inline_file(sys.argv[1], sys.argv[2:])
    argv = with_principal(piece, argv) if argv else argv
    url, tokfile = os.environ.get("LOOM_URL"), os.environ.get("LOOM_TOKEN_FILE")
    if not tokfile and os.environ.get("HOUSE_ID") and os.path.exists("/run/secrets/loom-token"):
        tokfile = "/run/secrets/loom-token"  # a house's own token, where loom-box put it
    if not url or not tokfile:
        sys.exit("piece-call: LOOM_URL and LOOM_TOKEN_FILE must be set")
    base = url.rstrip("/")
    if base.endswith("/mcp"):
        base = base[: -len("/mcp")]
    with open(tokfile) as f:
        token = f.read().strip()
    req = urllib.request.Request(
        f"{base}/api/{piece}/run", data=json.dumps({"argv": argv}).encode(), method="POST",
        headers={"content-type": "application/json", "authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            body = json.load(r)
    except urllib.error.HTTPError as e:
        try:
            why = json.load(e).get("error")
        except ValueError:
            why = None
        sys.exit(f"piece-call: loom refused {' '.join([piece] + argv[:1])}: {why or f'{e.code} {e.reason}'}")
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f"piece-call: couldn't reach loom at {base}: {e}")
    out = body.get("stdout")
    if out is None and body.get("stdoutGz"):
        out = gzip.decompress(base64.b64decode(body["stdoutGz"])).decode()
    code = body.get("exit")
    code = code if isinstance(code, int) else 1
    try:
        sys.stdout.write(out or "")
        sys.stdout.flush()
    except BrokenPipeError:
        # A reader that stopped early (| head): not an error of the command's.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    sys.stderr.write(body.get("stderr") or "")
    sys.exit(code)


if __name__ == "__main__":
    main()
