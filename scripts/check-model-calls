#!/usr/bin/env python3
"""Reject new direct one-shot CLI calls; pass --repo NAME=PATH for sibling repos.
Allowed sites are runtime implementations or documented compatibility exceptions.
This is a source guard, not a sandbox against computed/dynamic commands.
"""
import argparse
import ast
import json
import re
import subprocess
from pathlib import Path

# Shell spelling and argv spelling, including quoted CLI names and intervening
# flags. Read the entire source so splitting argv over lines cannot evade it.
DIRECT = re.compile(r'''\b(?:claude["']?(?:\s*,?\s*["']?[^\n;]{0,180}?)?(?:\s|["'],\s*["'])-p\b|codex["']?\s*,?\s*["']?exec\b)''')

def violations(root, allowed):
    names = subprocess.check_output(['git', '-C', str(root), 'ls-files', '-z'], text=True).split('\0')
    bad = []
    for name in names:
        p = Path(name)
        if not name or p.suffix in {'.md', '.jsonl', '.svg', '.lock'} or any(x in {'test', 'tests', '__fixtures__', 'vendor', '.beads', '.taskstore'} for x in p.parts) or p.name.startswith(('test-', 'test_')) or '.test.' in p.name:
            continue
        try: source = (root / name).read_text()
        except (UnicodeError, OSError): continue
        if p.suffix == '.py' or source.startswith('#!/usr/bin/env python'):
            try:
                tree = ast.parse(source)
                lines = source.splitlines()
                for node in ast.walk(tree):
                    if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)) and node.body and isinstance(node.body[0], ast.Expr) and isinstance(node.body[0].value, ast.Constant) and isinstance(node.body[0].value.value, str):
                        doc = node.body[0]
                        for i in range(doc.lineno - 1, doc.end_lineno): lines[i] = ''
                source = '\n'.join(lines)
            except SyntaxError:
                pass
        # Comments are documentation, not executable calls. Keep heredoc bodies:
        # scripts can contain executable shell in those.
        source = '\n'.join('' if line.lstrip().startswith(('#', '//', '*')) else line for line in source.splitlines())
        for match in DIRECT.finditer(source):
            line = source.count('\n', 0, match.start()) + 1
            if name not in allowed: bad.append(f'{name}:{line}: direct model call must use loom-runtime oneshot (or a reviewed allow-list entry)')
    return bad

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repo', action='append', default=[], metavar='NAME=PATH')
    args = parser.parse_args()
    home = Path(__file__).resolve().parents[1]
    manifest = json.loads((home / 'scripts/model-call-allowlist.json').read_text())
    repos = dict(x.split('=', 1) for x in args.repo) if args.repo else {'loom-box': str(home)}
    bad = []
    for name, path in repos.items():
        if name not in manifest: parser.error(f'unknown repo {name}')
        bad += [f'{name}/{x}' for x in violations(Path(path), manifest[name])]
    if bad: print('\n'.join(bad)); return 1
    print('model-call guard: no unlisted direct one-shot calls'); return 0

if __name__ == '__main__': raise SystemExit(main())
